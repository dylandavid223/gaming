<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Library | Neon Nexus</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    /* CYBERPUNK BASE STYLES */
    :root {
      --neon-pink: #ff2a6d;
      --neon-blue: #05d9e8;
      --neon-purple: #d300c5;
      --matrix-green: #00ff41;
      --dark-bg: #0d0221;
      --darker-bg: #050110;
      --grid-color: rgba(5, 217, 232, 0.1);
    }
    
    body {
      background-color: var(--dark-bg);
      background-image: 
        linear-gradient(var(--grid-color) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
      background-size: 20px 20px;
      color: white;
      font-family: 'Share Tech Mono', monospace;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* GLOW EFFECTS */
    @keyframes text-glow {
      0% { text-shadow: 0 0 5px var(--neon-blue); }
      50% { text-shadow: 0 0 20px var(--neon-blue), 0 0 30px var(--neon-purple); }
      100% { text-shadow: 0 0 5px var(--neon-blue); }
    }

    @keyframes border-glow {
      0% { box-shadow: 0 0 10px var(--neon-blue); }
      50% { box-shadow: 0 0 25px var(--neon-blue), 0 0 35px var(--neon-purple); }
      100% { box-shadow: 0 0 10px var(--neon-blue); }
    }

    /* MAIN CONTAINER */
    .lib-container {
      max-width: 1200px;
      margin: 40px auto;
      background: linear-gradient(145deg, rgba(13,2,33,0.95) 0%, rgba(25,5,60,0.95) 100%);
      border-radius: 0;
      border: 1px solid var(--neon-blue);
      box-shadow: 
        0 0 15px var(--neon-blue),
        inset 0 0 10px var(--neon-purple);
      padding: 30px;
      position: relative;
      overflow: hidden;
    }

    .lib-container::before {
      content: "";
      position: absolute;
      top: -10px;
      left: -10px;
      right: -10px;
      bottom: -10px;
      background: linear-gradient(
        45deg,
        var(--neon-blue),
        var(--neon-purple),
        var(--neon-pink),
        var(--neon-blue)
      );
      background-size: 400% 400%;
      z-index: -1;
      filter: blur(20px);
      opacity: 0.7;
      animation: gradient-pulse 8s ease infinite;
    }

    @keyframes gradient-pulse {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* TYPOGRAPHY */
    .lib-title {
      font-family: 'Orbitron', sans-serif;
      color: var(--neon-blue);
      font-size: 2.5rem;
      margin-bottom: 40px;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 3px;
      animation: text-glow 3s infinite;
      position: relative;
      padding-bottom: 15px;
    }

    .lib-title::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 150px;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--neon-pink), var(--neon-blue), transparent);
    }

    /* DATA TABLE */
    .lib-table {
      width: 100%;
      border-collapse: collapse;
      background: rgba(20, 5, 40, 0.7);
      backdrop-filter: blur(5px);
      border: 1px solid var(--neon-blue);
      box-shadow: 0 0 20px rgba(5, 217, 232, 0.3);
      position: relative;
      overflow: hidden;
    }

    .lib-table::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--neon-pink), var(--neon-blue), transparent);
      animation: scanline 3s linear infinite;
    }

    .lib-table th {
      background: linear-gradient(to bottom, rgba(210, 0, 197, 0.2), transparent);
      color: var(--neon-pink);
      font-family: 'Orbitron', sans-serif;
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 15px;
      text-align: left;
      border-bottom: 2px solid var(--neon-blue);
    }

    .lib-table td {
      padding: 12px 15px;
      border-bottom: 1px solid rgba(5, 217, 232, 0.3);
      color: #b3eaff;
    }

    .lib-table tr:last-child td {
      border-bottom: none;
    }

    .lib-table tr:hover {
      background: rgba(255, 42, 109, 0.1);
    }

    .lib-table tr:hover td {
      color: white;
      text-shadow: 0 0 5px var(--neon-blue);
    }

    .fav {
      color: var(--neon-pink);
      text-align: center;
      font-size: 1.2rem;
    }

    .fav::before {
      content: "★";
      animation: pulse 1.5s infinite alternate;
    }

    @keyframes pulse {
      from { opacity: 0.3; text-shadow: 0 0 5px var(--neon-pink); }
      to { opacity: 1; text-shadow: 0 0 15px var(--neon-pink), 0 0 25px var(--neon-purple); }
    }

    /* SCANLINES EFFECT */
    body::after {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        rgba(0, 255, 65, 0.05) 1px,
        transparent 1px
      );
      background-size: 100% 2px;
      pointer-events: none;
      z-index: 1000;
      animation: scanline 8s linear infinite;
    }

    @keyframes scanline {
      from { transform: translateY(-100%); }
      to { transform: translateY(100%); }
    }

    /* STATUS BARS */
    .playtime-cell {
      position: relative;
    }

    .playtime-cell::after {
      content: "";
      position: absolute;
      bottom: 5px;
      left: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--matrix-green), var(--neon-blue));
      width: calc(var(--playtime) * 2%);
      max-width: 100%;
      transition: width 0.5s ease;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .lib-container {
        margin: 20px;
        padding: 20px;
      }
      
      .lib-title {
        font-size: 1.8rem;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/header', { user: username }) %>
  
  <div class="lib-container">
    <div class="lib-title">// GAME LIBRARY //</div>
    <table class="lib-table">
      <thead>
        <tr>
          <th>GAME TITLE</th>
          <th>PLAYTIME</th>
          <th>LAST ACCESS</th>
          <th>ACHIEVEMENTS</th>
          <th>STATUS</th>
        </tr>
      </thead>
      <tbody>
        <% library.forEach(function(entry) { %>
          <tr>
            <td><span class="game-title">><%= entry.game_title %></span></td>
            <td class="playtime-cell" style="--playtime: <%= Math.min(entry.playtime_hours || 0, 50) %>">
              <%= entry.playtime_hours || '0' %>h
            </td>
            <td><%= entry.last_played ? entry.last_played.toISOString().slice(0,10) : '--/--/----' %></td>
            <td><%= entry.achievements_completed || '0' %>/<%= entry.total_achievements || '?' %></td>
            <td class="fav"><%= entry.favorite ? '' : '☆' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  
  <%- include('partials/footer') %>

  <script>
    // Add terminal-like typing effect to rows
    document.addEventListener('DOMContentLoaded', () => {
      const rows = document.querySelectorAll('.lib-table tbody tr');
      rows.forEach((row, i) => {
        row.style.opacity = '0';
        row.style.transform = 'translateX(20px)';
        
        setTimeout(() => {
          row.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
          row.style.opacity = '1';
          row.style.transform = 'translateX(0)';
        }, i * 100);
      });

      // Add interactive effects
      const favStars = document.querySelectorAll('.fav');
      favStars.forEach(star => {
        star.addEventListener('click', () => {
          star.classList.toggle('active');
        });
      });
    });
  </script>
</body>
</html>