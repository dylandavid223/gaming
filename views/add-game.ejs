<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>SUBMIT GAME // NEON NEXUS</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
    <style>
      /* CYBERPUNK BASE STYLES */
      :root {
        --neon-pink: #ff2a6d;
        --neon-blue: #05d9e8;
        --neon-purple: #d300c5;
        --matrix-green: #00ff41;
        --dark-bg: #0d0221;
        --darker-bg: #050110;
        --grid-color: rgba(5, 217, 232, 0.1);
      }

      body {
        background-color: var(--dark-bg);
        background-image: linear-gradient(
            var(--grid-color) 1px,
            transparent 1px
          ),
          linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
        background-size: 20px 20px;
        color: white;
        font-family: "Share Tech Mono", monospace;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      /* GLOW EFFECTS */
      @keyframes text-glow {
        0% {
          text-shadow: 0 0 5px var(--neon-blue);
        }
        50% {
          text-shadow: 0 0 20px var(--neon-blue), 0 0 30px var(--neon-purple);
        }
        100% {
          text-shadow: 0 0 5px var(--neon-blue);
        }
      }

      @keyframes border-glow {
        0% {
          box-shadow: 0 0 10px var(--neon-blue);
        }
        50% {
          box-shadow: 0 0 25px var(--neon-blue), 0 0 35px var(--neon-purple);
        }
        100% {
          box-shadow: 0 0 10px var(--neon-blue);
        }
      }

      /* MAIN CONTAINER */
      .submit-container {
        max-width: 800px;
        margin: 40px auto;
        background: linear-gradient(
          145deg,
          rgba(13, 2, 33, 0.95) 0%,
          rgba(25, 5, 60, 0.95) 100%
        );
        border-radius: 0;
        border: 1px solid var(--neon-blue);
        box-shadow: 0 0 15px var(--neon-blue), inset 0 0 10px var(--neon-purple);
        padding: 40px;
        position: relative;
        overflow: hidden;
      }

      .submit-container::before {
        content: "";
        position: absolute;
        top: -10px;
        left: -10px;
        right: -10px;
        bottom: -10px;
        background: linear-gradient(
          45deg,
          var(--neon-blue),
          var(--neon-purple),
          var(--neon-pink),
          var(--neon-blue)
        );
        background-size: 400% 400%;
        z-index: -1;
        filter: blur(20px);
        opacity: 0.7;
        animation: gradient-pulse 8s ease infinite;
      }

      @keyframes gradient-pulse {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }

      /* TYPOGRAPHY */
      .submit-title {
        font-family: "Orbitron", sans-serif;
        color: var(--neon-blue);
        font-size: 2.5rem;
        margin-bottom: 40px;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 3px;
        animation: text-glow 3s infinite;
        position: relative;
        padding-bottom: 15px;
      }

      .submit-title::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 200px;
        height: 3px;
        background: linear-gradient(
          90deg,
          transparent,
          var(--neon-pink),
          var(--neon-blue),
          transparent
        );
      }

      /* FORM ELEMENTS */
      .form-group {
        margin-bottom: 25px;
        position: relative;
      }

      .form-label {
        display: block;
        color: var(--neon-pink);
        font-family: "Orbitron", sans-serif;
        font-size: 1rem;
        margin-bottom: 8px;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .form-control {
        width: 100%;
        padding: 12px 15px;
        background: rgba(20, 5, 40, 0.7);
        border: 1px solid var(--neon-blue);
        color: #b3eaff;
        font-family: "Share Tech Mono", monospace;
        font-size: 1rem;
        transition: all 0.3s ease;
      }

      .form-control:focus {
        outline: none;
        border-color: var(--neon-pink);
        box-shadow: 0 0 10px var(--neon-purple);
      }

      textarea.form-control {
        min-height: 120px;
        resize: vertical;
      }

      .form-select {
        appearance: none;
        background: rgba(20, 5, 40, 0.7)
          url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2305d9e8'%3e%3cpath d='M7 10l5 5 5-5z'/%3e%3c/svg%3e")
          no-repeat;
        background-position: right 10px center;
        background-size: 20px;
      }

      .checkbox-group {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
      }

      .checkbox-label {
        color: #b3eaff;
        margin-left: 10px;
        cursor: pointer;
      }

      .checkbox-input {
        appearance: none;
        width: 20px;
        height: 20px;
        background: rgba(20, 5, 40, 0.7);
        border: 1px solid var(--neon-blue);
        position: relative;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .checkbox-input:checked {
        background: var(--neon-purple);
        border-color: var(--neon-pink);
      }

      .checkbox-input:checked::after {
        content: "✓";
        position: absolute;
        color: white;
        font-size: 14px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      }

      /* SUBMIT BUTTON */
      .submit-btn {
        display: block;
        width: 100%;
        padding: 15px;
        background: linear-gradient(
          90deg,
          var(--neon-blue),
          var(--neon-purple)
        );
        color: white;
        border: none;
        font-family: "Orbitron", sans-serif;
        font-size: 1.2rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .submit-btn:hover {
        background: linear-gradient(
          90deg,
          var(--neon-purple),
          var(--neon-pink)
        );
        box-shadow: 0 0 20px var(--neon-purple);
      }

      .submit-btn::before {
        content: "";
        position: absolute;
        top: -10px;
        left: -10px;
        right: -10px;
        bottom: -10px;
        border: 2px solid var(--neon-blue);
        animation: border-glow 3s infinite;
        pointer-events: none;
      }

      /* ERROR MESSAGE */
      .error-message {
        color: var(--neon-pink);
        text-align: center;
        margin-bottom: 20px;
        font-family: "Share Tech Mono", monospace;
        text-shadow: 0 0 10px var(--neon-pink);
      }

      /* SCANLINES EFFECT */
      body::after {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
          rgba(0, 255, 65, 0.05) 1px,
          transparent 1px
        );
        background-size: 100% 2px;
        pointer-events: none;
        z-index: 1000;
        animation: scanline 8s linear infinite;
      }

      @keyframes scanline {
        from {
          transform: translateY(-100%);
        }
        to {
          transform: translateY(100%);
        }
      }

      /* RESPONSIVE */
      @media (max-width: 768px) {
        .submit-container {
          margin: 20px;
          padding: 20px;
        }

        .submit-title {
          font-size: 1.8rem;
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/header') %>
    <h1>helllo <%= user.username%></h1>

    <div class="submit-container">
      <% if (error) { %>
      <div class="error-message">ERROR: <%= error %></div>
      <% } %>

      <div class="submit-title">// GAME SUBMISSION //</div>

      <form action="/submit-game" method="POST">
        <div class="form-group">
          <label for="title" class="form-label">GAME TITLE</label>
          <input
            type="text"
            id="title"
            name="title"
            class="form-control"
            required
          />
        </div>

        <div class="form-group">
          <label for="developer" class="form-label">DEVELOPER</label>
          <select
            id="developer"
            name="developer_id"
            class="form-control form-select"
            required
          >
            <option value="">SELECT DEVELOPER</option>
            <% developers.forEach(function(dev) { %>
            <option value="<%= dev.developer_id %>"><%= dev.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="release_date" class="form-label">RELEASE DATE</label>
          <input
            type="date"
            id="release_date"
            name="release_date"
            class="form-control"
            required
          />
        </div>

        <div class="form-group">
          <label for="price" class="form-label">PRICE (CREDITS)</label>
          <input
            type="number"
            id="price"
            name="price"
            class="form-control"
            min="0"
            step="0.01"
            required
          />
        </div>

        <div class="form-group">
          <label for="description" class="form-label">DESCRIPTION</label>
          <textarea
            id="description"
            name="description"
            class="form-control"
            required
          ></textarea>
        </div>

        <div class="form-group">
          <label for="genre" class="form-label">GENRE</label>
          <input
            type="text"
            id="genre"
            name="genre"
            class="form-control"
            required
          />
        </div>

        <div class="form-group">
          <label for="rating" class="form-label">RATING</label>
          <select
            id="rating"
            name="rating"
            class="form-control form-select"
            required
          >
            <option value="E">E - Everyone</option>
            <option value="T">T - Teen</option>
            <option value="M">M - Mature</option>
            <option value="AO">AO - Adults Only</option>
          </select>
        </div>

        <div class="form-group">
          <div class="checkbox-group">
            <input
              type="checkbox"
              id="multiplayer"
              name="multiplayer"
              class="checkbox-input"
            />
            <label for="multiplayer" class="checkbox-label"
              >MULTIPLAYER SUPPORT</label
            >
          </div>
        </div>

        <div class="form-group">
          <label for="platforms" class="form-label"
            >PLATFORMS (COMMA SEPARATED)</label
          >
          <input
            type="text"
            id="platforms"
            name="platforms"
            class="form-control"
            required
          />
        </div>

        <div class="form-group">
          <label for="cover_image_url" class="form-label"
            >COVER IMAGE URL</label
          >
          <input
            type="url"
            id="cover_image_url"
            name="cover_image_url"
            class="form-control"
            required
          />
        </div>

        <button type="submit" class="submit-btn">SUBMIT GAME</button>
      </form>
    </div>

    <%- include('partials/footer') %>

    <script>
      // Add interactive effects
      document.addEventListener("DOMContentLoaded", () => {
        // Animate form elements on focus
        const inputs = document.querySelectorAll(".form-control");
        inputs.forEach((input) => {
          input.addEventListener("focus", () => {
            input.parentElement.style.borderLeft = "3px solid var(--neon-pink)";
            input.parentElement.style.paddingLeft = "15px";
          });

          input.addEventListener("blur", () => {
            input.parentElement.style.borderLeft = "none";
            input.parentElement.style.paddingLeft = "10px";
          });
        });

        // Add typing animation to textarea
        const textarea = document.querySelector("textarea");
        textarea.addEventListener("focus", () => {
          textarea.style.boxShadow = "0 0 15px var(--neon-blue)";
        });

        textarea.addEventListener("blur", () => {
          textarea.style.boxShadow = "none";
        });
      });
    </script>
  </body>
</html>
