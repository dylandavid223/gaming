<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>GameHub | Home</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Rajdhani:wght@300;500;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        background: #0d0221;
        color: #fff;
        font-family: "Rajdhani", sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-image: radial-gradient(
          circle at 10% 20%,
          rgba(255, 42, 109, 0.1) 0%,
          transparent 20%
        );
      }
      .cyber-box {
        background: rgba(13, 2, 33, 0.85);
        border: 2px solid #05d9e8;
        border-radius: 12px;
        padding: 40px 60px;
        box-shadow: 0 0 40px #05d9e844;
        text-align: center;
      }
      .logo {
        font-family: "Orbitron", sans-serif;
        font-size: 2.5rem;
        color: #05d9e8;
        text-shadow: 0 0 10px #05d9e8, 0 0 20px #ff2a6d;
        margin-bottom: 20px;
        letter-spacing: 3px;
      }
      .cyber-btn {
        display: inline-block;
        margin: 15px 10px;
        padding: 14px 36px;
        font-size: 1.1rem;
        font-family: "Orbitron", sans-serif;
        color: #fff;
        background: linear-gradient(45deg, #05d9e8, #d300c5);
        border: none;
        border-radius: 5px;
        box-shadow: 0 0 10px #ff2a6d;
        cursor: pointer;
        transition: background 0.3s, box-shadow 0.3s;
        text-decoration: none;
      }
      .cyber-btn:hover {
        background: linear-gradient(45deg, #ff2a6d, #05d9e8);
        box-shadow: 0 0 20px #d300c5;
      }
      .desc {
        margin-bottom: 30px;
        color: #b3eaff;
        font-size: 1.2rem;
      }
    </style>
  </head>
  <body>
    <%- include('partials/header', { user: null }) %>
    <div class="cyber-box">
      <div class="logo">GameHub</div>
      <div class="desc">
        Welcome to the Cyberpunk GameHub!<br />Manage your games, developers,
        and more.
      </div>
      <a href="/login" class="cyber-btn">Login</a>
      <a href="/signup" class="cyber-btn">Sign Up</a>
    </div>
    <%- include('partials/footer') %>
  </body>
</html>
